{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curfew.app/schema/sync-payload.json",
  "title": "Curfew Sync Payload",
  "description": "FROZEN — additive-only forever (Story 1.10, AD-15). The single agent<->cloud derived-only seam (AD-3). Language-neutral mirror of SyncPayload in @curfew/shared.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "agent_version", "source", "set"],
  "properties": {
    "contract_version": {
      "description": "Contract version this payload was produced against.",
      "type": "integer",
      "const": 1
    },
    "agent_version": {
      "description": "Semver of the producing agent. AR-1: contract evolution is additive-only, and the cloud must accept the last N agent_versions (N not yet chosen — no cloud exists yet).",
      "type": "string"
    },
    "source": {
      "description": "Capture source (AR-15 enum).",
      "type": "string",
      "enum": ["serato"]
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_id", "started_at", "ended_at", "plays", "derived"],
      "properties": {
        "external_id": {
          "description": "Stable idempotency key for the set.",
          "type": "string"
        },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "plays": {
          "type": "array",
          "items": { "$ref": "#/$defs/play" }
        },
        "derived": { "$ref": "#/$defs/derived" }
      }
    }
  },
  "$defs": {
    "play": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "title",
        "artist",
        "started_at",
        "bpm",
        "genre",
        "camelot_key",
        "in_library"
      ],
      "properties": {
        "position": { "type": "integer", "minimum": 1 },
        "title": { "type": ["string", "null"] },
        "artist": { "type": ["string", "null"] },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "bpm": { "type": ["number", "null"] },
        "genre": {
          "oneOf": [{ "$ref": "#/$defs/genre" }, { "type": "null" }]
        },
        "camelot_key": {
          "type": ["string", "null"],
          "pattern": "^(1[0-2]|[1-9])[AB]$"
        },
        "in_library": { "type": "boolean" },
        "played_ms": {
          "description": "Real on-air duration in ms (Story 3.7 §3d: end_time − start_time, with agent-side next-play-start/set-end fallback). Added post-freeze, optional per AD-15.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "library_added_at": {
          "description": "ISO 8601 — library date-added via database V2 tadd/uadd by portable path (Story 3.7 §3d). Added post-freeze, optional per AD-15; null when no reachable catalogue covers the track.",
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "genre": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "normalized", "taxonomy_version"],
      "properties": {
        "raw": { "type": "string" },
        "normalized": { "type": "string" },
        "taxonomy_version": { "type": "integer" },
        "subgenre": {
          "description": "Added post-freeze (taxonomy v2). Optional per AD-15's additive-only rule, even though the agent always populates it alongside normalized in practice.",
          "type": "string"
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "most_played_tracks",
        "most_played_artists",
        "genre_breakdown",
        "bpm_distribution",
        "camelot_mixing_stats",
        "set_length_sec",
        "track_count",
        "energy_arc",
        "confidence"
      ],
      "properties": {
        "most_played_tracks": {
          "type": "array",
          "items": { "$ref": "#/$defs/most_played_track" }
        },
        "most_played_artists": {
          "type": "array",
          "items": { "$ref": "#/$defs/most_played_artist" }
        },
        "genre_breakdown": { "$ref": "#/$defs/genre_breakdown" },
        "subgenre_breakdown": { "$ref": "#/$defs/subgenre_breakdown" },
        "bpm_distribution": { "$ref": "#/$defs/bpm_distribution" },
        "camelot_mixing_stats": { "$ref": "#/$defs/camelot_mixing_stats" },
        "set_length_sec": { "type": ["integer", "null"] },
        "track_count": { "type": "integer" },
        "energy_arc": {
          "type": "array",
          "items": { "$ref": "#/$defs/energy_arc_point" }
        },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "most_played_track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "artist", "play_count"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "artist": { "type": ["string", "null"] },
        "play_count": { "type": "integer" }
      }
    },
    "most_played_artist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artist", "play_count"],
      "properties": {
        "artist": { "type": "string" },
        "play_count": { "type": "integer" }
      }
    },
    "genre_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buckets", "no_genre_count"],
      "properties": {
        "buckets": {
          "type": "array",
          "items": { "$ref": "#/$defs/genre_bucket" }
        },
        "no_genre_count": { "type": "integer" }
      }
    },
    "genre_bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["genre", "play_count"],
      "properties": {
        "genre": { "type": "string" },
        "play_count": { "type": "integer" }
      }
    },
    "subgenre_breakdown": {
      "description": "Added post-freeze (taxonomy v2). Same shape/discipline as genre_breakdown, one level finer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["buckets", "no_genre_count"],
      "properties": {
        "buckets": {
          "type": "array",
          "items": { "$ref": "#/$defs/subgenre_bucket" }
        },
        "no_genre_count": { "type": "integer" }
      }
    },
    "subgenre_bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subgenre", "genre", "play_count"],
      "properties": {
        "subgenre": { "type": "string" },
        "genre": { "type": "string" },
        "play_count": { "type": "integer" }
      }
    },
    "bpm_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "min", "max", "mean", "median"],
      "properties": {
        "count": { "type": "integer" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "mean": { "type": "number" },
        "median": { "type": "number" }
      }
    },
    "camelot_mixing_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatible_transitions", "incompatible_transitions", "excluded_no_key"],
      "properties": {
        "compatible_transitions": { "type": "integer" },
        "incompatible_transitions": { "type": "integer" },
        "excluded_no_key": { "type": "integer" }
      }
    },
    "energy_arc_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "bpm"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "bpm": { "type": "number" }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "track_count", "long_gap_count"],
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 1 },
        "track_count": { "type": "integer" },
        "long_gap_count": { "type": "integer" }
      }
    }
  }
}
