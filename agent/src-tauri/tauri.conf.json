{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Curfew Agent",
  "version": "0.0.0",
  "identifier": "app.curfew.agent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Curfew Agent",
        "width": 420,
        "height": 320,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
