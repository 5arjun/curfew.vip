{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Curfew Agent",
  "version": "0.0.0",
  "identifier": "app.curfew.agent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Curfew Agent Settings",
        "width": 400,
        "height": 640,
        "resizable": false,
        "minimizable": false,
        "visible": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data:",
        "connect-src": "ipc: http://ipc.localhost",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4RkE2MzVDMzM3OTExRjgKUldUNEVYa3pYR1A2R0E1bTN4Z29KdHFwbFF4MEVqYzArc2lkWDF1bldGbFNHRG9mNFkyK0d5TGUK",
      "endpoints": [
        "https://github.com/5arjun/curfew.vip/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "curfew-agent"
        ]
      }
    }
  }
}
